# .env.example — Copy to .env and fill in your values
# NEVER commit the actual .env file

# ─── App Config ───────────────────────────────────────────────────
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://your-app.vercel.app
ALLOWED_ORIGIN=https://your-app.vercel.app

# ─── Clerk Auth ───────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ─── Neon PostgreSQL ──────────────────────────────────────────────
# Get from: https://console.neon.tech → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Multi-LLM Chain (fallback: Anthropic → OpenAI → Groq) ───────
# 🔥 PRIMARY (best reasoning)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
MODEL_PRIMARY=claude-haiku-4-5

# 🔁 FALLBACK 1
OPENAI_API_KEY=sk-proj-your_openai_key
MODEL_FALLBACK=gpt-4o-mini

# 🔁 FALLBACK 2 (cheap + fast)
GROQ_API_KEY=gsk_your_groq_key
MODEL_FAST=llama-3.3-70b-versatile

# 🔁 OPTIONAL (multi-provider router)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# ─── Razorpay (payment processing) ────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── RAG / Search ────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your_tavily_key

# ─── Other API Keys (optional) ───────────────────────────────────
GOOGLE_API_KEY=
HUGGINGFACE_TOKEN=
GITHUB_TOKEN=

# ─── Sentry (optional — error monitoring) ────────────────────────
VITE_SENTRY_DSN=
